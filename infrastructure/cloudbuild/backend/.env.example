# Local template for testing the production backend image with
#   infrastructure/cloudbuild/build.sh infrastructure/cloudbuild/backend/Dockerfile 8080 infrastructure/cloudbuild/backend/.env
#
# Copy to `.env` (gitignored) and fill in real values. Never commit it.
#
# In production these are NOT read from a file: Cloud Run mounts them from Secret
# Manager with --set-secrets. Secret IDs are prefixed for the shared project:
#
#   DATABASE_URL           -> forsetiemblem-prod-database-url
#   MIGRATION_DATABASE_URL -> forsetiemblem-prod-migration-database-url  (build only)
#   OPENAI_API_KEY         -> forsetiemblem-prod-openai-api-key
#   REDIS_URL              -> forsetiemblem-prod-redis-url
#   TURNSTILE_SECRET_KEY   -> forsetiemblem-prod-turnstile-secret-key
#   DOCS_PASSWORD          -> forsetiemblem-prod-docs-password
#   DOCS_SESSION_SECRET    -> forsetiemblem-prod-docs-session-secret

ENVIRONMENT=production

# Supabase PostgreSQL. Use the pooled connection (port 6543) for the app
# and the direct connection (port 5432) for Alembic migrations.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Upstash Redis (rediss:// URL)
REDIS_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# API docs protection
DOCS_AUTH_ENABLED=false
DOCS_AUTH_MODE=session
DOCS_USERNAME=
DOCS_PASSWORD=
DOCS_SESSION_SECRET=
DOCS_SESSION_TTL_SECONDS=180

# Rate limits and cost controls
RATE_LIMIT_SHORT_WINDOW_SECONDS=30
RATE_LIMIT_SHORT_IP_REQUESTS=3
RATE_LIMIT_LONG_WINDOW_SECONDS=86400
RATE_LIMIT_LONG_IP_REQUESTS=15
SESSION_RATE_LIMIT_LONG_IP_REQUESTS=15
REQUEST_MAX_CHARS=300
RAG_TOP_K_MAX=8

# CORS (single origin)
CORS_ALLOWED_ORIGIN=http://localhost:3000
