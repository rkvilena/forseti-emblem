# Local template for testing the production frontend image with
#   infrastructure/cloudbuild/build.sh infrastructure/cloudbuild/frontend/Dockerfile 3000 infrastructure/cloudbuild/frontend/.env
#
# Copy to `.env` (gitignored) and fill in real values. Never commit it.
# All NEXT_PUBLIC_* values are inlined at BUILD time by Next.js.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CHAT_STORAGE_KEY=forsetiemblem-chat-messages

NODE_ENV=production
